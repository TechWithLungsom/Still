PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/still.sqlite
UPLOAD_DIR=./data/uploads
COOKIE_SECURE=false
NODE_ENV=development
# Set NODE_ENV=production, COOKIE_SECURE=true and APP_ORIGIN=https://your-domain
# behind an HTTPS reverse proxy. npm run build && npm start serves the built UI.

# STUN helps establish direct calls; deploy a TURN relay for restrictive networks.
RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# Example for a provisioned TURN server (replace with your credentials):
# RTC_ICE_SERVERS=[{"urls":"turn:turn.your-domain:3478","username":"your-user","credential":"your-password"}]
RTC_RELAY_ONLY=false

# Only set this when hosting the frontend separately.
# VITE_REALTIME_ORIGIN is a PUBLIC Render HTTPS origin, not a secret.
VITE_REALTIME_ORIGIN=
# Set false on the Render API service.
SERVE_FRONTEND=true
